{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://firmware.dev/schemas/chip.manifest.v1.json",
    "title":  "firmware Chip Manifest",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "manifestVersion",
                     "chipId",
                     "name",
                     "version",
                     "artifact",
                     "entrypoint",
                     "permissions",
                     "economics"
                 ],
    "properties":  {
                       "manifestVersion":  {
                                               "const":  "1"
                                           },
                       "chipId":  {
                                      "$ref":  "#/$defs/digest"
                                  },
                       "name":  {
                                    "type":  "string",
                                    "minLength":  1,
                                    "maxLength":  96
                                },
                       "version":  {
                                       "type":  "string",
                                       "pattern":  "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                                   },
                       "artifact":  {
                                        "type":  "object",
                                        "additionalProperties":  false,
                                        "required":  [
                                                         "uri",
                                                         "sha256",
                                                         "runtime"
                                                     ],
                                        "properties":  {
                                                           "uri":  {
                                                                       "type":  "string",
                                                                       "minLength":  1
                                                                   },
                                                           "sha256":  {
                                                                          "$ref":  "#/$defs/digest"
                                                                      },
                                                           "runtime":  {
                                                                           "enum":  [
                                                                                        "wasm32-wasi",
                                                                                        "container",
                                                                                        "remote"
                                                                                    ]
                                                                       }
                                                       }
                                    },
                       "entrypoint":  {
                                          "type":  "string",
                                          "minLength":  1
                                      },
                       "permissions":  {
                                           "type":  "object",
                                           "additionalProperties":  false,
                                           "required":  [
                                                            "network",
                                                            "contracts",
                                                            "spend",
                                                            "delegation"
                                                        ],
                                           "properties":  {
                                                              "network":  {
                                                                              "type":  "array",
                                                                              "uniqueItems":  true,
                                                                              "items":  {
                                                                                            "type":  "string",
                                                                                            "minLength":  1
                                                                                        }
                                                                          },
                                                              "contracts":  {
                                                                                "type":  "array",
                                                                                "items":  {
                                                                                              "type":  "object",
                                                                                              "additionalProperties":  false,
                                                                                              "required":  [
                                                                                                               "target",
                                                                                                               "selectors",
                                                                                                               "maxValueWei",
                                                                                                               "spendMode",
                                                                                                               "budgetAsset",
                                                                                                               "amountOffset"
                                                                                                           ],
                                                                                              "properties":  {
                                                                                                                 "target":  {
                                                                                                                                "$ref":  "#/$defs/address"
                                                                                                                            },
                                                                                                                 "selectors":  {
                                                                                                                                   "type":  "array",
                                                                                                                                   "minItems":  1,
                                                                                                                                   "uniqueItems":  true,
                                                                                                                                   "items":  {
                                                                                                                                                 "type":  "string",
                                                                                                                                                 "pattern":  "^0x[0-9a-fA-F]{8}$"
                                                                                                                                             }
                                                                                                                               },
                                                                                                                 "maxValueWei":  {
                                                                                                                                     "$ref":  "#/$defs/uintString"
                                                                                                                                 },
                                                                                                                 "spendMode":  {
                                                                                                                                   "enum":  [
                                                                                                                                                "none",
                                                                                                                                                "nativeValue",
                                                                                                                                                "calldataUint256"
                                                                                                                                            ]
                                                                                                                               },
                                                                                                                 "budgetAsset":  {
                                                                                                                                     "$ref":  "#/$defs/address"
                                                                                                                                 },
                                                                                                                 "amountOffset":  {
                                                                                                                                      "type":  "integer",
                                                                                                                                      "minimum":  0,
                                                                                                                                      "maximum":  65535
                                                                                                                                  }
                                                                                                             }
                                                                                          }
                                                                            },
                                                              "spend":  {
                                                                            "type":  "array",
                                                                            "items":  {
                                                                                          "type":  "object",
                                                                                          "additionalProperties":  false,
                                                                                          "required":  [
                                                                                                           "asset",
                                                                                                           "perInvocation",
                                                                                                           "perWindow",
                                                                                                           "windowSeconds"
                                                                                                       ],
                                                                                          "properties":  {
                                                                                                             "asset":  {
                                                                                                                           "$ref":  "#/$defs/address"
                                                                                                                       },
                                                                                                             "perInvocation":  {
                                                                                                                                   "$ref":  "#/$defs/uintString"
                                                                                                                               },
                                                                                                             "perWindow":  {
                                                                                                                               "$ref":  "#/$defs/uintString"
                                                                                                                           },
                                                                                                             "windowSeconds":  {
                                                                                                                                   "type":  "integer",
                                                                                                                                   "minimum":  1
                                                                                                                               }
                                                                                                         }
                                                                                      }
                                                                        },
                                                              "delegation":  {
                                                                                 "type":  "boolean"
                                                                             }
                                                          }
                                       },
                       "economics":  {
                                         "type":  "object",
                                         "additionalProperties":  false,
                                         "required":  [
                                                          "model",
                                                          "asset",
                                                          "maximumPrice"
                                                      ],
                                         "properties":  {
                                                            "model":  {
                                                                          "enum":  [
                                                                                       "fixed",
                                                                                       "metered"
                                                                                   ]
                                                                      },
                                                            "asset":  {
                                                                          "$ref":  "#/$defs/address"
                                                                      },
                                                            "maximumPrice":  {
                                                                                 "$ref":  "#/$defs/uintString"
                                                                             }
                                                        }
                                     }
                   },
    "$defs":  {
                  "address":  {
                                  "type":  "string",
                                  "pattern":  "^0x[0-9a-fA-F]{40}$"
                              },
                  "digest":  {
                                 "type":  "string",
                                 "pattern":  "^0x[0-9a-fA-F]{64}$"
                             },
                  "uintString":  {
                                     "type":  "string",
                                     "pattern":  "^(0|[1-9][0-9]*)$"
                                 }
              }
}
